PORT=4000
CLIENT_URL=http://localhost:3000

# Redis Connection (Upstash or local)
# Leave empty to automatically use built-in atomic in-memory Redis engine
# Example: rediss://default:xxxx@us1-fond-squid-xxxxx.upstash.io:6379
REDIS_URL=

# Postgres Database (Neon or local)
# Leave empty to automatically use built-in relational store with UNIQUE constraints
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/snaptix?sslmode=require
DATABASE_URL=

# Hold duration in seconds (5 minutes = 300)
HOLD_DURATION_SECONDS=300

# Event ID
EVENT_ID=venue-grand-hall
